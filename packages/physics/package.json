{
  "name": "@place-it/physics",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./worker": "./dist/worker.js"
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build": "tsup",
    "size": "size-limit"
  },
  "dependencies": { "@dimforge/rapier3d-compat": "0.21.0", "@place-it/core": "workspace:*", "@place-it/platform-web": "workspace:*" },
  "devDependencies": { "@vitest/browser-playwright": "5.0.5", "playwright": "^1.50.0", "vite": "^8.3.5" },
  "size-limit": [
    { "path": "dist/index.js", "limit": "5 KB", "gzip": true },
    { "path": "dist/worker.js", "limit": "2 MB", "gzip": true }
  ]
}
