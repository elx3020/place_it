{
  "name": "@place-it/tracking",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build": "tsup",
    "size": "size-limit"
  },
  "dependencies": { "@place-it/core": "workspace:*", "@mediapipe/tasks-vision": "1.2.0" },
  "devDependencies": { "@place-it/platform-web": "workspace:*", "@vitest/browser-playwright": "5.0.5", "playwright": "^1.50.0", "vite": "^8.3.5" },
  "size-limit": [{ "path": "dist/index.js", "limit": "10 KB", "gzip": true }]
}
